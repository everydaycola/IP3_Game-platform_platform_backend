@ClientId=go-backend
@ClientSecret=b0ZVXfrGkyFlgXTPXtvCBOM4TLZzc9UY
@player1username=123
@player1password=123
@baseUrl = http://localhost:8080/api/user
@friendId=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaa456


### Get access token
POST http://localhost:8180/realms/FourteenGames/protocol/openid-connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded

client_id={{ClientId}}&client_secret={{ClientSecret}}&username={{player1username}}&password={{player1password}}&grant_type=password&scope=openid

> {%
    client.global.set("access_token", response.body.access_token);
%}


### register yourself to the platform (this can be used to populate users based on their jwt token from for ex. first signin)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

> {%
    client.global.set("userId", response.body.id);
%}

### Add a friend
PATCH {{baseUrl}}/friends/{{friendId}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

### Get friendlist
GET {{baseUrl}}/friends
Content-Type: application/json
Authorization: Bearer {{access_token}}
### Remove a friend

DELETE {{baseUrl}}/friends/{{friendId}}
Content-Type: application/json
Authorization: Bearer {{access_token}}