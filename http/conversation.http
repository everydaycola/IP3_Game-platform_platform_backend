@baseUrl = http://localhost:8070/api/conversations
@ClientId=go-backend
@ClientSecret=b0ZVXfrGkyFlgXTPXtvCBOM4TLZzc9UY
@player1username=123
@player1password=123


### Get access token (user 1)
POST http://localhost:8180/realms/FourteenGames/protocol/openid-connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded

client_id={{ClientId}}&client_secret={{ClientSecret}}&username={{player1username}}&password={{player1password}}&grant_type=password&scope=openid

> {%
    client.global.set("access_token", response.body.access_token);
%}

### register user 1 to the platform (this can be used to populate users based on their jwt token from for ex. first signin)
POST http://localhost:8070/api/user
Content-Type: application/json
Authorization: Bearer {{access_token}}

> {%
    client.global.set("userId", response.body.id);
%}

### Start conversation (user)
POST {{baseUrl}}/start
Authorization: Bearer {{access_token}}

> {%
    client.global.set("conversationId", response.body.id);
%}


### Get conversation (user)
GET {{baseUrl}}/{{conversationId}}
Authorization: Bearer {{access_token}}


### Send message (user)
POST {{baseUrl}}/{{conversationId}}/messages
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "text": "How do I see my friends?",
  "sentTime": "2026-01-03T12:00:00Z",
  "gameName": "",
  "currentPageUrl": "https://localhost/store"
}


### End conversation (user)
DELETE {{baseUrl}}/{{conversationId}}
Authorization: Bearer {{access_token}}


### Start conversation (visitor)
POST {{baseUrl}}/visitor/start

> {%
    client.global.set("visitorConversationId", response.body.id);
%}

### Get conversation (visitor)
GET {{baseUrl}}/{{visitorConversationId}}


### Send message (visitor)
POST {{baseUrl}}/visitor/{{visitorConversationId}}/messages
Content-Type: application/json

{
  "text": "How do I see my friends?",
  "sentTime": "2026-01-03T12:00:00Z",
  "gameName": "",
  "currentPageUrl": "https://localhost/store"
}


### End conversation (visitor)
DELETE {{baseUrl}}/visitor/{{visitorConversationId}}
