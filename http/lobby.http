@baseUrl = http://localhost:8080/api/lobby
@ClientId=go-backend
@ClientSecret=b0ZVXfrGkyFlgXTPXtvCBOM4TLZzc9UY
@player1username=123
@player1password=123
@player2username=456
@player2password=456
@player3username=789
@player3password=789

### Get access token (user 1)
POST http://localhost:8180/realms/FourteenGames/protocol/openid-connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded

client_id={{ClientId}}&client_secret={{ClientSecret}}&username={{player1username}}&password={{player1password}}&grant_type=password&scope=openid

> {%
    client.global.set("access_token", response.body.access_token);
%}

### Get access token (user 2)
POST http://localhost:8180/realms/FourteenGames/protocol/openid-connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded

client_id={{ClientId}}&client_secret={{ClientSecret}}&username={{player2username}}&password={{player2password}}&grant_type=password&scope=openid

> {%
    client.global.set("access_token_2", response.body.access_token);
%}
### Get access token (user 3)
POST http://localhost:8180/realms/FourteenGames/protocol/openid-connect/token HTTP/1.1
Content-Type: application/x-www-form-urlencoded

client_id={{ClientId}}&client_secret={{ClientSecret}}&username={{player3username}}&password={{player3password}}&grant_type=password&scope=openid

> {%
    client.global.set("access_token_3", response.body.access_token);
%}

### register user 1 to the platform
POST http://localhost:8080/api/user
Content-Type: application/json
Authorization: Bearer {{access_token}}

> {%
    client.global.set("userId", response.body.id);
%}

### register user 2 to the platform
POST http://localhost:8080/api/user
Content-Type: application/json
Authorization: Bearer {{access_token_2}}

> {%
    client.global.set("userId", response.body.id);
%}

### register user 3 to the platform
POST http://localhost:8080/api/user
Content-Type: application/json
Authorization: Bearer {{access_token_3}}

> {%
    client.global.set("userId", response.body.id);
%}

### Get all open lobbies from the server.
GET {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

### Create a new lobby as player #1 for Tic-Tac-Toe
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "gameId": "11111111-1111-1111-1111-111111111111"
}

> {%
    client.global.set("lobbyId", response.body.id);
%}

### join the lobby player #1 created as player #2.
PATCH {{baseUrl}}/{{lobbyId}}
Content-Type: application/json
Authorization: Bearer {{access_token_2}}

### join the lobby player #1 created as player #3. (should return an error explaining the lobby is full)
PATCH {{baseUrl}}/{{lobbyId}}
Content-Type: application/json
Authorization: Bearer {{access_token_3}}

### Leave the tic-tac-toe lobby (as player 1) which caues player 2 to become the manager of the lobby.
DELETE {{baseUrl}}/{{lobbyId}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

### Leave the tic-tac-toe lobby (as player 2) which causes the lobby to be removed from db.
DELETE {{baseUrl}}/{{lobbyId}}
Content-Type: application/json
Authorization: Bearer {{access_token_2}}