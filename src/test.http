@baseUrl = http://localhost:8080/api/games
@ttt = 11111111-1111-1111-1111-111111111111
@go = 22222222-2222-2222-2222-222222222222
@tetris = 33333333-3333-3333-3333-333333333333

### Get All Games
GET {{baseUrl}}

### Get Tic Tac Toe
GET {{baseUrl}}/{{ttt}}

### Get Go
GET {{baseUrl}}/{{go}}

### Get Tetris
GET {{baseUrl}}/{{tetris}}

### Get non-existing game
GET {{baseUrl}}/99999999-9999-9999-9999-999999999999